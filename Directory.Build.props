<Project>
  <PropertyGroup>
    <!-- Organization profile, not Game: this is a package repository, and the
         Game profile requires its anchor to be an engine-free Core project,
         which by definition this repository cannot have. -->
    <B44AgentSyncEnabled>true</B44AgentSyncEnabled>
    <B44AgentGuidanceProfile>Organization</B44AgentGuidanceProfile>
    <B44AgentRepositoryRoot>$(MSBuildThisFileDirectory)</B44AgentRepositoryRoot>
    <B44AgentSyncProject>$(MSBuildThisFileDirectory)B44.Unity.Compile\B44.Unity.Compile.csproj</B44AgentSyncProject>

    <!-- Source-size ratchet, same anchor so both repository-wide checks run once. -->
    <B44RatchetEnabled>true</B44RatchetEnabled>
    <B44RatchetProject>$(MSBuildThisFileDirectory)B44.Unity.Compile\B44.Unity.Compile.csproj</B44RatchetProject>
    <B44RatchetRepositoryRoot>$(MSBuildThisFileDirectory)</B44RatchetRepositoryRoot>
    <B44RatchetBaseline>$(MSBuildThisFileDirectory)ratchet-baseline.txt</B44RatchetBaseline>

    <!-- B44EngineFreeCore is deliberately NOT set and must never be. This is the
         one B44 repository allowed to reference Unity; the guard exists to keep
         Unity out of everywhere else.

         B44Deterministic IS set, for the same reason B44.Godot sets it: engine
         coupling is not a licence for ambient time or randomness. Nothing here
         reads a clock, so the rule costs nothing and stops the first thing that
         tries. -->
    <B44Deterministic>true</B44Deterministic>

    <!-- ================= Unity runtime baseline =================
         The one place the current Unity runtime generation is written down.
         Unity 6 runs a Mono/.NET Standard 2.1 profile and compiles at C# 9;
         the modern Unity line runs CoreCLR. Neither of those is an
         architectural fact about B44, and nothing below the integration
         boundary knows either number.

         B44.Unity.Compile builds the package sources against BOTH, so the
         Unity-6 profile is proved today and the modern one is proved ready.
         Retargeting is then a deletion here plus the packaging changes listed
         in CLAUDE.md — not a port. -->
    <B44UnityRuntimeTargetFramework>netstandard2.1</B44UnityRuntimeTargetFramework>
    <B44UnityFutureTargetFramework>net8.0</B44UnityFutureTargetFramework>
    <B44UnityLangVersion>9.0</B44UnityLangVersion>

    <Nullable>enable</Nullable>
    <!-- Shared package builds must never normalize a new warning into the
         baseline. Consumer repositories opt into this independently. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- We generate doc files to enable IDE0005 and to ship docs for the members
         we do document, not to document every public member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- B44.Unity.Compile multi-targets, and both anchored targets above run once
       per inner build. Pinning them to the current Unity baseline keeps the two
       repository-wide scans from running twice over the same generated files
       concurrently. -->
  <PropertyGroup Condition="'$(TargetFramework)' != '' and '$(TargetFramework)' != '$(B44UnityRuntimeTargetFramework)'">
    <B44AgentSyncEnabled>false</B44AgentSyncEnabled>
    <B44RatchetEnabled>false</B44RatchetEnabled>
  </PropertyGroup>

  <ItemGroup>
    <B44RatchetExclude Include="B44.Unity.Tests" />
    <!-- The Unity fixture's compilation is Unity's job, and its editor-generated
         projects and library caches are not source. -->
    <B44RatchetExclude Include="proving" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="B44.Standards" Version="0.11.*" PrivateAssets="all" />
  </ItemGroup>
</Project>
